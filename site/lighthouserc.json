{
  "ci": {
    "collect": {
      "startServerCommand": "npx --yes serve@14.2.4 --no-request-logging --listen tcp://127.0.0.1:8090 /tmp/renderd-site-lh",
      "startServerReadyPattern": "Accepting connections",
      "url": [
        "http://127.0.0.1:8090/",
        "http://127.0.0.1:8090/download/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median-run"
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500,
            "aggregationMethod": "median-run"
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05,
            "aggregationMethod": "median-run"
          }
        ],
        "resource-summary:total:size": [
          "error",
          {
            "maxNumericValue": 204800,
            "aggregationMethod": "median-run"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "/tmp/renderd-site-lh-report"
    }
  }
}
