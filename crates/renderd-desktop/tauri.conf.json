{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Renderd",
  "identifier": "dev.renderd.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Renderd",
        "width": 420,
        "height": 660,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#0D0D0D",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Use a Windows PC as a display for your Mac.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
