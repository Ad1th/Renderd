{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "bash site/build.sh",
  "outputDirectory": "site/public",
  "trailingSlash": true,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/overview.html", "destination": "/", "permanent": true },
    { "source": "/features.html", "destination": "/", "permanent": true },
    { "source": "/platforms.html", "destination": "/", "permanent": true },
    { "source": "/faq.html", "destination": "/", "permanent": true },
    { "source": "/architecture.html", "destination": "/#how", "permanent": false },
    { "source": "/docs.html", "destination": "/download/#first-run", "permanent": false },
    { "source": "/contributing.html", "destination": "https://github.com/Ad1th/Renderd/blob/main/CONTRIBUTING.md", "permanent": false },
    { "source": "/releases.html", "destination": "https://github.com/Ad1th/Renderd/releases", "permanent": false },
    { "source": "/roadmap.html", "destination": "https://github.com/Ad1th/Renderd#project-feature-roadmap", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/((?!api/).*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
